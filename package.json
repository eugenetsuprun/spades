{
  "name": "spades",
  "version": "0.1.0",
  "description": "Solo Cutthroat Spades — strong deterministic AI, terminal app",
  "type": "module",
  "bin": {
    "spades": "./dist/cli/main.js"
  },
  "scripts": {
    "play": "tsx src/cli/main.tsx",
    "selfplay": "tsx src/harness/selfplay.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8"
  }
}
